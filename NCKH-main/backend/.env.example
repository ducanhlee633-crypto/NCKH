SUPABASE_URL=https://your-project.supabase.co
# Backend bắt buộc: chỉ dùng ở server, KHÔNG bao giờ lộ ra frontend.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# SUPABASE_KEY is accepted as an alias for SUPABASE_SERVICE_ROLE_KEY.
# Backend cần để login/signup qua Supabase Auth + frontend cần để gọi Auth trực tiếp.
SUPABASE_ANON_KEY=your-anon-public-key
# Khuyến nghị: để backend verify JWT nhanh tại chỗ (Project Settings > API > JWT Secret).
# Nếu bỏ trống, backend sẽ verify bằng cách gọi Supabase Auth API.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
