SUPABASE_URL=https://your-project.supabase.co
# Backend bắt buộc: chỉ dùng ở server, KHÔNG bao giờ lộ ra frontend.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# SUPABASE_KEY is accepted as an alias for SUPABASE_SERVICE_ROLE_KEY.
# Backend cần để login/signup qua Supabase Auth + frontend cần để gọi Auth trực tiếp.
SUPABASE_ANON_KEY=your-anon-public-key
# Khuyến nghị: để backend verify JWT nhanh tại chỗ (Project Settings > API > JWT Secret).
# Nếu bỏ trống, backend sẽ verify bằng cách gọi Supabase Auth API.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Domain frontend để Supabase dẫn về sau khi user bấm link xác nhận email
# (frontend tự đăng nhập rồi đẩy tiếp vào onboarding).
# Phải trùng Site URL / Redirect URLs trong Supabase Dashboard > Authentication > URL Configuration.
# Local: http://localhost:5173 — Production: https://nhip-hoc.vercel.app
FRONTEND_URL=http://localhost:5173
# OpenRouter chat AI (chỉ backend dùng, KHÔNG lộ ra frontend).
# Lấy key tại https://openrouter.ai/keys rồi paste vào backend/.env
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free